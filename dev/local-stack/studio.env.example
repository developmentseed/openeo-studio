# Studio settings for the local stack. `make studio` passes them to the container (docker --env-file);
# to run Studio on the host instead: cp -i dev/local-stack/studio.env.example .env.local
# Keep values unquoted: docker --env-file would keep the quotes.
VITE_BASE_URL=http://localhost:9000
VITE_OPENEO_API_URL=http://localhost:8081
# The backend advertises Keycloak's in-cluster URL; the browser needs the host one.
VITE_AUTH_AUTHORITY=http://localhost:8082/realms/openeo
# Empty: the client comes from the backend (GET /credentials/oidc). Overrides any value in a .env file.
VITE_AUTH_CLIENT_ID=
VITE_AUTH_REDIRECT_URI=
# Without these the page title is the literal %VITE_APP_TITLE%.
VITE_APP_TITLE=openEO Studio (local)
VITE_APP_DESCRIPTION=Local stack: titiler-openeo + Keycloak on kind
